#!/usr/bin/env python3
"""payload/claude-seed: merges Claude Code's first-run answers into
`$HOME/.claude.json`, shipped by amap-deploy-openshell on the read-only payload.

payload/amap-main runs it once, before it starts the delivery daemon or
`claude`, so no first-run question waits for a keyboard (decision D9 of
IMPLEMENTATION-PLAN.md). It writes:

- `hasCompletedOnboarding`, and `lastOnboardingVersion` set to the running
  Claude Code version, the first word of `claude --version`;
- `projects[<workdir>].hasTrustDialogAccepted`, where the workdir is this
  process's working directory, which is `claude`'s;
- the last 20 characters of $ANTHROPIC_API_KEY, appended to
  `customApiKeyResponses.approved`.

These names were observed on Claude Code 2.1.284 and are not documented (D9).
L1 checks that no prompt blocks.

OpenShell gives the agent a placeholder for the provider's credential, not the
real key (OpenShell main@acbac9c: docs/how-it-works/providers/overview.mdx:
366-369). The suffix is computed here, inside the sandbox, because it is the
placeholder's suffix that Claude Code compares. The key and the suffix are never
printed. The full key is never written.

The merge is additive. A key that is already present keeps its value, even
`false`; only the suffix is appended, and only if it is absent. A container of
the wrong type is refused, never replaced. When nothing would change, nothing is
written. A new file is created with mode 0600, and an existing file keeps its
mode and is replaced atomically. An absent file is created; an empty file, a
file that is not JSON, and a symlink are refused and left untouched, because
absent and empty are different answers.

Standard library only. Python 3.9 compatible.
"""

import copy
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
from typing import Optional

CONFIG_NAME = ".claude.json"
ONBOARDING_KEY = "hasCompletedOnboarding"
VERSION_KEY = "lastOnboardingVersion"
PROJECTS_KEY = "projects"
TRUST_KEY = "hasTrustDialogAccepted"
API_KEY_RESPONSES_KEY = "customApiKeyResponses"
APPROVED_KEY = "approved"
API_KEY_ENV = "ANTHROPIC_API_KEY"
SUFFIX_LENGTH = 20
NEW_FILE_MODE = 0o600
VERSION_TIMEOUT_SECONDS = 60
VERSION_RE = re.compile(r"\d+\.\d+\.\d+([-+.][0-9A-Za-z.-]+)?\Z")
EXIT_FAILED = 1


class SeedError(Exception):
    pass


def claude_version(claude: str = "claude") -> str:
    """The running Claude Code's version: the first word of `claude --version`,
    which prints `2.1.284 (Claude Code)` on 2.1.284."""
    try:
        p = subprocess.run([claude, "--version"], stdin=subprocess.DEVNULL,
                           capture_output=True, text=True,
                           timeout=VERSION_TIMEOUT_SECONDS)
    except (OSError, subprocess.SubprocessError) as e:
        raise SeedError("`%s --version` did not run: %s" % (claude, e))
    if p.returncode != 0:
        raise SeedError("`%s --version` exited %d" % (claude, p.returncode))
    words = p.stdout.split()
    if not words or not VERSION_RE.match(words[0]):
        raise SeedError("`%s --version` did not print a version" % claude)
    return words[0]


def key_suffix(key: str) -> str:
    if len(key) <= SUFFIX_LENGTH:
        raise SeedError("%s has %d characters; it must have more than %d, or "
                        "its suffix would be the whole key"
                        % (API_KEY_ENV, len(key), SUFFIX_LENGTH))
    return key[-SUFFIX_LENGTH:]


def load(path: str) -> Optional[dict]:
    """The document at `path`, or None when it is absent."""
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return None
    except OSError as e:
        raise SeedError("cannot read %s: %s" % (path, e))
    if stat.S_ISLNK(st.st_mode):
        raise SeedError("%s is a symlink; it is not replaced" % path)
    if not stat.S_ISREG(st.st_mode):
        raise SeedError("%s is not a regular file" % path)
    try:
        with open(path, "r", encoding="utf-8") as fh:
            text = fh.read()
    except (OSError, ValueError) as e:
        raise SeedError("cannot read %s: %s" % (path, e))
    if text.strip() == "":
        raise SeedError("%s is empty; it is not overwritten" % path)
    try:
        doc = json.loads(text)
    except (ValueError, RecursionError) as e:
        raise SeedError("%s is not JSON: %s" % (path, e))
    if not isinstance(doc, dict):
        raise SeedError("%s is not a JSON object" % path)
    return doc


def seeded(doc: dict, version: str, workdir: str, suffix: str) -> dict:
    """A deep copy of `doc` with the answers merged in."""
    out = copy.deepcopy(doc)
    out.setdefault(ONBOARDING_KEY, True)
    out.setdefault(VERSION_KEY, version)
    projects = out.setdefault(PROJECTS_KEY, {})
    if not isinstance(projects, dict):
        raise SeedError("%s is not an object; it is not replaced"
                        % PROJECTS_KEY)
    project = projects.setdefault(workdir, {})
    if not isinstance(project, dict):
        raise SeedError("%s.%s is not an object; it is not replaced"
                        % (PROJECTS_KEY, workdir))
    project.setdefault(TRUST_KEY, True)
    responses = out.setdefault(API_KEY_RESPONSES_KEY, {})
    if not isinstance(responses, dict):
        raise SeedError("%s is not an object; it is not replaced"
                        % API_KEY_RESPONSES_KEY)
    approved = responses.setdefault(APPROVED_KEY, [])
    if not isinstance(approved, list):
        raise SeedError("%s.%s is not a list; it is not replaced"
                        % (API_KEY_RESPONSES_KEY, APPROVED_KEY))
    if suffix not in approved:
        approved.append(suffix)
    return out


def write(path: str, doc: dict, mode: int) -> None:
    """Replaces `path` atomically, with `mode`."""
    directory = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".claude-seed-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(json.dumps(doc, indent=2, ensure_ascii=False) + "\n")
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def main() -> int:
    home = os.environ.get("HOME", "")
    if not home:
        raise SeedError("HOME is not set or is empty; the answers go in "
                        "$HOME/%s" % CONFIG_NAME)
    key = os.environ.get(API_KEY_ENV, "")
    if not key:
        raise SeedError("%s is not set or is empty; the API-key answer is "
                        "its suffix" % API_KEY_ENV)
    suffix = key_suffix(key)
    path = os.path.join(home, CONFIG_NAME)
    before = load(path)
    version = claude_version()
    after = seeded(before if before is not None else {}, version,
                   os.getcwd(), suffix)
    if after == before:
        return 0
    mode = NEW_FILE_MODE if before is None else os.stat(path).st_mode & 0o7777
    write(path, after, mode)
    return 0


if __name__ == "__main__":
    try:
        code = main()
    except (SeedError, OSError) as e:
        sys.stderr.write("claude-seed: %s\n" % e)
        code = EXIT_FAILED
    sys.exit(code)
